---
type Props = astroHTML.JSX.VideoHTMLAttributes & {
  caption?: string;
  type?: string;
  src: ImageMetadata;
};
const { src, type, caption, ...props } = Astro.props;
---

<figure>
  <video {...props} autoplay playsinline muted controls>
    <source src={src} type={type} />
  </video>
  {caption && <figcaption>{caption}</figcaption>}
</figure>
