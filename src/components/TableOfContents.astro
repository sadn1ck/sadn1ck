---
import type { MarkdownHeading } from "astro";

interface Props {
  headings: MarkdownHeading[];
}

const { headings } = Astro.props as Props;
const items = headings.filter(
  (heading) => heading.depth === 2 || heading.depth === 3,
);
---

{
  items.length > 0 && (
    <aside
      class="table-of-contents"
      aria-label="On this page"
      data-table-of-contents
    >
      <a class="table-of-contents-top" href="#" data-toc-top>
        <span>On this page</span>
        <span aria-hidden="true">↑</span>
      </a>
      <ol>
        {items.map((heading) => (
          <li class:list={{ "is-subheading": heading.depth === 3 }}>
            <a href={`#${heading.slug}`} data-toc-link={heading.slug}>
              {heading.text}
            </a>
          </li>
        ))}
      </ol>
    </aside>
  )
}

<script>
  const tableOfContents = document.querySelector<HTMLElement>(
    "[data-table-of-contents]",
  );

  if (tableOfContents) {
    const links = new Map(
      [
        ...tableOfContents.querySelectorAll<HTMLAnchorElement>(
          "[data-toc-link]",
        ),
      ].map((link) => [link.dataset.tocLink, link]),
    );
    const setActiveLink = (id?: string) => {
      for (const [slug, link] of links) {
        link.toggleAttribute("aria-current", slug === id);
      }

      tableOfContents.classList.toggle(
        "has-active-section",
        id !== undefined && id !== links.keys().next().value,
      );
    };

    const headings = [...links.keys()]
      .map((slug) => document.getElementById(slug!))
      .filter((heading): heading is HTMLElement => heading !== null);

    const setActiveFromScrollPosition = () => {
      const viewportMarker = window.innerHeight * 0.3;
      const activeHeading =
        Math.ceil(window.scrollY + window.innerHeight) >=
        document.documentElement.scrollHeight
          ? headings.at(-1)
          : ([...headings]
              .reverse()
              .find(
                (heading) =>
                  heading.getBoundingClientRect().top <= viewportMarker,
              ) ?? headings[0]);

      setActiveLink(activeHeading?.id);
    };

    let scrollScheduled = false;
    const scheduleScrollUpdate = () => {
      if (scrollScheduled) return;

      scrollScheduled = true;
      requestAnimationFrame(() => {
        scrollScheduled = false;
        setActiveFromScrollPosition();
      });
    };

    tableOfContents.addEventListener("click", (event) => {
      const target = event.target as Element;

      const link = target.closest<HTMLAnchorElement>("[data-toc-link]");

      if (link?.dataset.tocLink) setActiveLink(link.dataset.tocLink);
    });
    window.addEventListener("scroll", scheduleScrollUpdate, { passive: true });
    window.addEventListener("hashchange", scheduleScrollUpdate);
    scheduleScrollUpdate();
  }
</script>
