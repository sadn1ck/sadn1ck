---
import type { CollectionEntry } from "astro:content";
import { readFile, stat } from "node:fs/promises";
import { dirname, join } from "node:path";

const { entry } = Astro.props as { entry: CollectionEntry<"work"> };
const directory = dirname(entry.filePath ?? "");
const svgPath = join(process.cwd(), directory, "logo.svg");
const pngPath = join(process.cwd(), directory, "logo.png");

const hasSvgLogo = await stat(svgPath).then(
  () => true,
  () => false,
);
const svgLogo = hasSvgLogo ? await readFile(svgPath, "utf-8") : null;
const pngLogo = hasSvgLogo
  ? null
  : `data:image/png;base64,${(await readFile(pngPath)).toString("base64")}`;

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat("en-US", { month: "short", year: "numeric" }).format(
    date,
  );
const endDate =
  entry.data.endDate > new Date() ? "Present" : formatDate(entry.data.endDate);
---

<a class="work-entry" href={`/work/${entry.id}`}>
  {svgLogo && <span class="work-logo" aria-hidden="true" set:html={svgLogo} />}
  {pngLogo && <img class="work-logo" src={pngLogo} alt="" />}
  <span class="work-details">
    <strong class="work-role">{entry.data.role}</strong>
    <span class="work-company">{entry.data.company}</span>
    <time class="work-period"
      >{formatDate(entry.data.startDate)} — {endDate}</time
    >
  </span>
</a>
