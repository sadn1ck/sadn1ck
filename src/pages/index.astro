---
import WritingCard from "@components/WritingCard.astro";
import WorkCard from "@components/WorkCard.astro";
import { HOME, SITE, SOCIALS } from "@consts";
import Layout from "@layouts/Layout.astro";
import { getCollection } from "astro:content";
import {
  blogToWritingEntry,
  hasFinishedWork,
  sortWorkEntries,
  sortWritingEntries,
  workToWritingEntry,
} from "../writing";

const blog = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .map(blogToWritingEntry);
const work = (await getCollection("work")).sort(sortWorkEntries);
const writing = [
  ...blog,
  ...work
    .filter((entry) => !entry.data.draft && hasFinishedWork(entry))
    .map(workToWritingEntry),
]
  .sort(sortWritingEntries)
  .slice(0, SITE.NUM_BLOGS_ON_HOMEPAGE);
---

<Layout title={HOME.TITLE} description={HOME.DESCRIPTION}>
  <p class="intro">
    Software developer at udaan. Building reliable systems with intuitive
    interfaces.
  </p>
  <section>
    <header class="section-heading">
      <h2>Writing</h2>
      <a href="/blog">View all <span aria-hidden="true">→</span></a>
    </header>
    <ul class="writing-list">
      {
        writing.map((entry) => (
          <li>
            <WritingCard entry={entry} />
          </li>
        ))
      }
    </ul>
  </section>
  <section>
    <h2>Work</h2>
    <ul class="work-list">
      {
        work.map((post) => (
          <li>
            <WorkCard entry={post} />
          </li>
        ))
      }
    </ul>
  </section>
  <section>
    <h2>Elsewhere</h2>
    <p>
      {
        SOCIALS.map((social, index) => (
          <>
            <a href={social.HREF}>{social.NAME}</a>
            {index < SOCIALS.length - 1 && " · "}
          </>
        ))
      }
    </p>
  </section>
</Layout>
