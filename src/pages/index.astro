---
import BlogCard from "@components/BlogCard.astro";
import WorkCard from "@components/WorkCard.astro";
import { HOME, SITE, SOCIALS } from "@consts";
import Layout from "@layouts/Layout.astro";
import { getCollection } from "astro:content";

const blog = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_BLOGS_ON_HOMEPAGE);
const work = (await getCollection("work"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.order - a.data.order);
---

<Layout title={HOME.TITLE} description={HOME.DESCRIPTION}>
  <p>
    Software engineer working on rich text editors, CRDTs, TypeScript, state
    machines, and developer tools.
  </p>
  <section>
    <header class="section-heading">
      <h2>Writing</h2>
      <a href="/blog">View all <span aria-hidden="true">→</span></a>
    </header>
    <ul class="writing-list">
      {
        blog.map((post) => (
          <li>
            <BlogCard entry={post} />
          </li>
        ))
      }
    </ul>
  </section>
  <section>
    <h2>Work</h2>
    <ul class="work-list">
      {
        work.map((post) => (
          <li>
            <WorkCard entry={post} />
          </li>
        ))
      }
    </ul>
  </section>
  <section>
    <h2>Elsewhere</h2>
    <p>
      {
        SOCIALS.map((social, index) => (
          <>
            <a href={social.HREF}>{social.NAME}</a>
            {index < SOCIALS.length - 1 && " · "}
          </>
        ))
      }
    </p>
  </section>
</Layout>
