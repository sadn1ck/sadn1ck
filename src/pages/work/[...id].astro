---
import Layout from "@layouts/Layout.astro";
import { type CollectionEntry, getCollection, render } from "astro:content";
export async function getStaticPaths() {
  return (await getCollection("work"))
    .filter((post) => !post.data.draft)
    .map((post) => ({ params: { id: post.id }, props: post }));
}
const post = Astro.props as CollectionEntry<"work">;
const { Content } = await render(post);
---

<Layout
  title={post.data.company}
  description={`Things I did as a ${post.data.role} at ${post.data.company}`}
>
  <a href="/work">← Work</a>
  <header><h1>{post.data.role} at {post.data.company}</h1></header>
  <article><Content /></article>
</Layout>
