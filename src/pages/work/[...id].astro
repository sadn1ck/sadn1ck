---
import Layout from "@layouts/Layout.astro";
import TableOfContents from "@components/TableOfContents.astro";
import { type CollectionEntry, getCollection, render } from "astro:content";
export async function getStaticPaths() {
  return (await getCollection("work"))
    .filter((post) => !post.data.draft)
    .map((post) => ({ params: { id: post.id }, props: post }));
}
const post = Astro.props as CollectionEntry<"work">;
const { Content, headings } = await render(post);
const currentRole = post.data.roles.at(-1)!;
---

<Layout
  title={`${currentRole.title} at ${post.data.company}`}
  description={`Things I did at ${post.data.company}`}
>
  <a href="/blog">← Writing</a>
  <header><h1>{currentRole.title} at {post.data.company}</h1></header>
  <article><Content /></article>
  <TableOfContents headings={headings} />
</Layout>
